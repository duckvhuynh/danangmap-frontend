{
  "name": "danangmap-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "api:generate": "node scripts/generate-api-client.mjs",
    "api:sync": "node scripts/generate-api-client.mjs --sync",
    "api:check": "node scripts/generate-api-client.mjs --check",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live:mapbox": "playwright test -c playwright.mapbox.config.ts e2e-live/mapbox-live-qa.spec.ts",
    "test:e2e:real:history": "playwright test -c playwright.real.config.ts e2e-real/publication-history-rollback.spec.ts",
    "test:e2e:real:publication": "playwright test -c playwright.real.config.ts e2e-real/durable-publication-progress.spec.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tabler/icons-react": "3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "4.4.5",
    "input-otp": "^1.5.0",
    "mapbox-gl": "3.29.0",
    "next": "16.3.1",
    "openapi-fetch": "^0.15.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1",
    "terra-draw": "1.32.3",
    "terra-draw-mapbox-gl-adapter": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.3.1",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
