NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Public URL-restricted Mapbox token only. Never use a secret token in the browser.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional basemap overrides. Keep the official styles as safe defaults.
NEXT_PUBLIC_MAPBOX_STREET_STYLE=mapbox://styles/mapbox/streets-v12
NEXT_PUBLIC_MAPBOX_LIGHT_STYLE=mapbox://styles/mapbox/light-v11
# Local demonstration only. Must remain false in production.
NEXT_PUBLIC_DANANGMAP_DEMO_MODE=false
# Local-only principal used until the authenticated server session supplies its subject.
DANANGMAP_DEV_PRINCIPAL_ID=local-demo-system-admin
